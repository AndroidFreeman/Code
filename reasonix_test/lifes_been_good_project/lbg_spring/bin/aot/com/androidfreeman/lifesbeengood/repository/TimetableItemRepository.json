    {
      "name": "deleteByOwnerProfileId",
      "signature": "public abstract void com.androidfreeman.lifesbeengood.repository.TimetableItemRepository.deleteByOwnerProfileId(java.lang.String)",
      "query": {
        "query": "SELECT t FROM TimetableItem t WHERE t.ownerProfileId = :ownerProfileId"
      }
    },
    {
      "name": "deleteByOwnerProfileIdAndWeekdayAndStartPeriod",
      "signature": "public abstract void com.androidfreeman.lifesbeengood.repository.TimetableItemRepository.deleteByOwnerProfileIdAndWeekdayAndStartPeriod(java.lang.String,int,int)",
      "query": {
        "query": "SELECT t FROM TimetableItem t WHERE t.ownerProfileId = :ownerProfileId AND t.weekday = :weekday AND t.startPeriod = :startPeriod"
      }
    },
    {
